<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only needed before Android 10, which has scoped Downloads access. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- No auto backup: the Dropbox tokens are stored unencrypted (see TODO.md),
        so ever copying them into Google cloud backups must be opt-in later,
        once tokens are not stored in plaintext. -->
    <application
        android:label="KalibreBox"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- Lets other apps read downloaded books from the cache (open/share). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:label="KalibreBox"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Replaced by androiddeployqt with the app's deps/libs. -->
            <meta-data android:name="android.app.lib_name" android:value="kalibrebox" />
        </activity>
    </application>
</manifest>
